# ==============================================================================
# HIKVISION / EZVIZ CLOUD TO RTSP BRIDGE CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Mode: False for real DVR cloud streaming, True to test with a public mock stream
HIK_MOCK_MODE=False

# Developer API Credentials (from open.ezvizlife.com or open.hik-connect.com)
HIK_APP_KEY=YOUR_APP_KEY_HERE
HIK_APP_SECRET=YOUR_APP_SECRET_HERE

# Target DVR Serial Number (e.g., D22115206)
HIK_DEVICE_SERIAL=YOUR_DEVICE_SERIAL

# Camera Channels to expose as RTSP streams (comma-separated list, e.g. 1 or 1,2,5)
HIK_CHANNELS=1

# Stream Quality: 1 = Main Stream (HD / 1080p), 2 = Sub-Stream (SD / 480p)
HIK_STREAM_QUALITY=1

# Regional Cloud OpenAPI Host
# EZVIZ Open Platform: https://open.ezvizlife.com
# Hik-Connect TPP:     https://open.hik-connect.com
HIK_BASE_URL=https://open.ezvizlife.com

# MediaMTX Server Endpoints
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_API_PORT=9997
MEDIAMTX_RTSP_PORT=8554
